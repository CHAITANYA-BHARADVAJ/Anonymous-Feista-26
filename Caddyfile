{
    # Global Caddy options
    email {$ACME_EMAIL:admin@anonymoussdmcet.in}
    admin off

    # Force HTTP/1.1 and HTTP/2 over TCP only.
    # Disables HTTP/3 (QUIC / UDP port 443) which is blocked by default on AWS EC2 Security Groups
    # and causes browser handshakes to hang and requests to time out.
    servers {
        protocols h1 h2
    }
}

# Dynamic domain from environment (e.g. 13.126.101.127.nip.io or hunt.yourdomain.com)
{$DOMAIN:localhost} {
    # High-performance compression for map tiles, vectors, and JS bundles
    encode gzip zstd

    # Guard upload size cleanly at proxy edge (matches 10MB photo cap with multipart overhead)
    request_body {
        max_size 15MB
    }

    # Security headers (allow self geolocation & camera for GPS radar & victory photo)
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(self), camera=(self)"
        -Server
    }

    # Never cache service worker or HTML shell across deployments
    @nocache {
        path / /index.html /sw.js /registerSW.js /manifest.webmanifest
    }
    header @nocache {
        Cache-Control "no-store, must-revalidate"
    }

    # Aggressive browser caching for Vite hashed production assets
    @static {
        path /assets/*
    }
    header @static {
        Cache-Control "public, max-age=31536000, immutable"
    }

    # Health check passthrough
    handle /api/v1/health {
        reverse_proxy app:3001
    }

    # Reverse proxy to unified Node.js Express server
    # Automatically proxies WebSockets (Socket.io) with HTTP/1.1 Upgrade headers
    reverse_proxy app:3001 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
