# ===============================================
# Local Development Settings
# ===============================================
DATABASE_URL="file:./dev.db"
# Generate in production with: openssl rand -hex 32
JWT_SECRET="replace-with-32-byte-random-hex-in-production"
ADMIN_USERNAME="admin"
# Must be >= 8 chars and NOT a default like admin123 when NODE_ENV=production
ADMIN_PASSWORD="replace-with-strong-admin-password"
PORT=3001
CLIENT_URL="http://localhost:5173"
UPLOAD_DIR="./uploads"

# ===============================================
# AWS EC2 Docker Production Settings (via Caddy)
# ===============================================
# Set DOMAIN to your EC2 Public IP with .nip.io (e.g. 13.126.101.127.nip.io)
# or your custom domain (e.g. hunt.anonymoussdmcet.in).
# Caddy will automatically generate and renew Let's Encrypt HTTPS certificates for this domain!
DOMAIN=your-ec2-ip.nip.io
ACME_EMAIL=admin@anonymoussdmcet.in
FORCE_SEED=false
